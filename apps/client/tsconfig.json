{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Carried over from the Expo base this used to extend: some browser packages
    // the client imports are CommonJS, and their default imports need it.
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom", "webmcp-types"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "web/**/*.ts",
    "web/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../../types/assets.d.ts"
  ]
}
