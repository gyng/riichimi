{
  "expo": {
    "name": "Riichimi",
    "slug": "riichimi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "riichimi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.riichimi.calculator",
      "supportsTablet": true
    },
    "android": {
      "package": "app.riichimi.calculator"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Riichimi to scan a winning mahjong hand."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Riichimi to open a mahjong hand photo for local scoring."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
