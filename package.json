{
  "name": "riichimi",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first riichi mahjong recognition and scoring for the browser.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "npm run build:web --workspace @riichimi/client",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:ui",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives",
    "serve:web": "node scripts/serve-static.mjs",
    "start": "npm run start --workspace @riichimi/client",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:ui": "npm run test:coverage --workspace @riichimi/client",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "web": "npm run web --workspace @riichimi/client",
    "typecheck": "tsc --noEmit -p packages/score-core/tsconfig.json && tsc --noEmit -p packages/session-core/tsconfig.json && tsc --noEmit -p packages/vision/tsconfig.json && tsc --noEmit -p packages/rules/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/client/tsconfig.json",
    "screenshots": "node scripts/screenshots/capture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "webmcp-types": "0.1.3"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.0.1"
}
